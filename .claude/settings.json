{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",    
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(gofmt -w *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go run *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(docker compose *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git clean *)",
      "Bash(del *)",
      "Bash(erase *)",
      "Bash(Remove-Item *)",
      "Bash(curl *|*)",
      "Bash(curl *&&*)",
      "Bash(curl *;*)",
      "Bash(curl *--output*)",
      "Bash(curl *-o*)",
      "Bash(curl *-O*)",
      "Bash(curl *--remote-name*)",
      "Bash(curl *--upload-file*)",
      "Bash(curl *-T*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "changed=$(git diff --name-only -- '*.go' | tr '\\n' ' '); if [ -n \"$changed\" ]; then gofmt -w $changed; fi"
          }
        ]
      }
    ]
  }
}